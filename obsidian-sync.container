# Podman Quadlet for obsidian-headless-sync-docker
#
# Before starting, create the environment file with your credentials:
#   mkdir -p ~/.config/obsidian-sync
#   install -m 600 /dev/null ~/.config/obsidian-sync/obsidian-sync.env
#   # Then populate it — see Environment Variables section below.

[Unit]
Description=Obsidian Headless Sync
Documentation=https://github.com/crosbyh/obsidian-headless-sync-docker
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/crosbyh/obsidian-headless-sync-docker:latest
ContainerName=obsidian-sync
Pull=newer
AutoUpdate=registry

# Hardening: all runtime state lives on the vault volume, the sync-state
# volume, or the /run tmpfs.
ReadOnly=true
Tmpfs=/run
NoNewPrivileges=true

# Healthcheck (quadlet does not inherit the image HEALTHCHECK by default).
# Add Notify=healthy to delay systemd "started" until the first check passes.
HealthCmd=/usr/local/bin/healthcheck
HealthInterval=60s
HealthTimeout=15s
HealthStartPeriod=120s
HealthRetries=3

# Secrets and required configuration.
# File must exist before the service starts.
# Required keys: OBSIDIAN_AUTH_TOKEN, VAULT_NAME
#
# Example ~/.config/obsidian-sync/obsidian-sync.env:
#   OBSIDIAN_AUTH_TOKEN=<token from get-token>
#   VAULT_NAME=My Vault
#   VAULT_PASSWORD=
#   PUID=0
#   PGID=0
#   DEVICE_NAME=obsidian-podman
#   CONFLICT_STRATEGY=merge
#   EXCLUDED_FOLDERS=
#   FILE_TYPES=
#   SYNC_MODE=
#   SYNC_CONFIGS=
#   CONFIG_DIR=
#   SYNC_ONESHOT=
#   OBSIDIAN_AUTH_TOKEN_FILE=   (alternative to OBSIDIAN_AUTH_TOKEN; e.g. a podman secret path)
#   VAULT_PASSWORD_FILE=        (alternative to VAULT_PASSWORD)
#   VAULT_NAME_1= VAULT_NAME_2= (multi-vault; each syncs to a subdirectory of the volume)
#
# %E expands to ~/.config for user services, /etc/xdg for system services.
EnvironmentFile=%E/obsidian-sync/obsidian-sync.env

# Podman secrets (optional): create them once with
#   printf '%s' "<token>"    | podman secret create obsidian_token -
#   printf '%s' "<password>" | podman secret create vault_password -
# then uncomment the lines below and set in the env file:
#   OBSIDIAN_AUTH_TOKEN_FILE=/run/secrets/obsidian_token
#   VAULT_PASSWORD_FILE=/run/secrets/vault_password
#Secret=obsidian_token
#Secret=vault_password

Environment=PUID=0
Environment=PGID=0
Environment=VAULT_PATH=/vault
Environment=DEVICE_NAME=obsidian-podman
Environment=CONFLICT_STRATEGY=merge
Environment=EXCLUDED_FOLDERS=
Environment=FILE_TYPES=
Environment=SYNC_MODE=
Environment=SYNC_CONFIGS=
Environment=CONFIG_DIR=

# Vault volume — %h expands to the home directory of the service user.
# Change the host path to wherever you want vault files stored.
Volume=%h/obsidian-vault:/vault:z

# Persistent CLI state (auth/device/sync db) on a named volume, so the same
# registered sync device is reused across container recreates.
Volume=obsidian-sync-state:/data

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
