# ============================================================
# obsidian-headless-sync-docker — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ---- Required -----------------------------------------------

# Auth token obtained via: docker run --rm -it <image> get-token
OBSIDIAN_AUTH_TOKEN=

# Name of the remote Obsidian Sync vault to sync
# List available vaults: docker run --rm -e OBSIDIAN_AUTH_TOKEN=... <image> ob sync-list-remote
VAULT_NAME=My Vault

# Vault end-to-end encryption password (required if E2E encryption is enabled on the vault)
VAULT_PASSWORD=

# Absolute path on the host where vault files should land
VAULT_HOST_PATH=./vault

# ---- File ownership -----------------------------------------
#
# Controls which host user owns the synced vault files.
#
# Regular Docker (daemon runs as root):
#   Set to your host user's UID/GID — run `id` to find them.
#   PUID=1000
#   PGID=1000
#
# Rootless Docker (daemon runs as your user):
#   Container UID 0 already maps to your host user, so use:
#   PUID=0
#   PGID=0
#
PUID=1000
PGID=1000

# ---- Optional -----------------------------------------------

# Image source (override when self-building)
# GHCR_REPO=crosbyh/obsidian-headless-sync-docker

# Device label shown in Obsidian Sync history
DEVICE_NAME=obsidian-docker

# Conflict resolution strategy: merge | conflict
CONFLICT_STRATEGY=merge

# Comma-separated list of vault-relative folders to exclude from sync
# Example: EXCLUDED_FOLDERS=Private,Archive
EXCLUDED_FOLDERS=

# Comma-separated extra file types to sync: image,audio,video,pdf,unsupported
# Leave blank to sync all supported types
FILE_TYPES=

# Override the in-container vault path (advanced; rarely needed)
# VAULT_PATH=/vault

# Sync mode: bidirectional | pull-only (download only, ignore local changes) | mirror-remote (download only, revert local changes)
SYNC_MODE=

# Comma-separated config categories to sync: app,appearance,appearance-data,hotkey,core-plugin,core-plugin-data,community-plugin,community-plugin-data
# Leave blank to keep the default config sync behavior
SYNC_CONFIGS=

# Vault config directory name (advanced; default .obsidian)
# CONFIG_DIR=.obsidian

# Run a single sync then exit, instead of continuous mode (for cron/timers)
SYNC_ONESHOT=

# Secrets via files (Docker/Podman secrets) — alternatives to the plain vars above.
# Do not set both the plain and _FILE variant of the same variable.
# OBSIDIAN_AUTH_TOKEN_FILE=/run/secrets/obsidian_token
# VAULT_PASSWORD_FILE=/run/secrets/vault_password

# Multi-vault mode: numbered groups replace VAULT_NAME; each vault syncs to a
# subdirectory of the vault volume named after the vault.
# VAULT_NAME_1=Personal
# VAULT_NAME_2=Work
# VAULT_PASSWORD_2=
